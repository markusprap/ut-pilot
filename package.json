{
    "name": "ut-pilot-monorepo",
    "private": true,
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev --workspace=ut-pilot-api\" \"npm run dev --workspace=ut-pilot-web\"",
        "dev:api": "npm run dev --workspace=ut-pilot-api",
        "dev:web": "npm run dev --workspace=ut-pilot-web",
        "build": "npm run build --workspaces",
        "install:all": "npm install"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}