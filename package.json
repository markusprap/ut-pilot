{
  "name": "ut-pilot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "api"
  ],
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev --workspace=api\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=api",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=api",
    "vercel-build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=api",
    "clean": "rm -rf node_modules frontend/node_modules api/node_modules",
    "install:all": "npm install && npm install --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
